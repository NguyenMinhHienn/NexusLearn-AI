# ── Server ─────────────────────────────────────────────────────────
PORT=3001

# ── Database ───────────────────────────────────────────────────────
# Cách 1: Từng tham số riêng lẻ (XAMPP local hoặc VPS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=studymate
# Bật DB_SSL=true nếu dùng Cloud Database (TiDB Cloud, Aiven, PlanetScale...)
DB_SSL=false

# Cách 2: Connection URL (Railway / Render Cloud DB tự cấp chuỗi này)
# DATABASE_URL=mysql://root:password@containers-us-west-1.railway.app:7321/railway

# ── Auth ───────────────────────────────────────────────────────────
# QUAN TRỌNG: Đổi key này khi deploy production!
JWT_SECRET=nexuslearn_super_secret_key_2026

# ── Google OAuth ───────────────────────────────────────────────────
# Lấy Client ID tại: https://console.cloud.google.com/apis/credentials
# Tạo OAuth 2.0 Client ID → Web application → Authorized JavaScript origins: http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ── AI (Gemini) ────────────────────────────────────────────────────
# Lấy API key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Security ───────────────────────────────────────────────────────
# Danh sách origin được phép gọi API (phân cách bằng dấu phẩy)
# Ví dụ production: https://nexuslearn.example.com,https://www.nexuslearn.example.com
ALLOWED_ORIGINS=http://localhost:5173

# ── Email (nếu có) ────────────────────────────────────────────────
SUPPORT_EMAIL=admin@studymate.com
